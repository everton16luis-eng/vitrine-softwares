# =============================================================
# Copie este arquivo para .env e ajuste os valores.
# NUNCA versione o arquivo .env com credenciais reais.
# =============================================================

# Ambiente: development | production | test
NODE_ENV=development
PORT=3000
# Interface de rede. Vazio = todas. Em servidor com Nginx na frente, use 127.0.0.1 para que a
# porta interna não fique acessível pela internet.
HOST=

# URL pública do site (usada em canonical, sitemap, Open Graph e e-mails)
APP_URL=http://localhost:3000

# Conexão PostgreSQL (formato: postgres://usuario:senha@host:porta/banco)
DATABASE_URL=postgres://postgres:ALTERE_A_SENHA@localhost:5432/vitrine_softwares
# Banco exclusivo para testes automatizados (o nome DEVE terminar em _test; ele é apagado a cada execução)
DATABASE_URL_TEST=postgres://postgres:ALTERE_A_SENHA@localhost:5432/vitrine_softwares_test
# Use "true" em provedores que exigem SSL (ex.: bancos gerenciados)
DATABASE_SSL=false

# Segredo usado para assinar tokens de formulário (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
APP_SECRET=ALTERE_PARA_UM_VALOR_ALEATORIO_LONGO

# Sessões
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# Força cookie Secure (padrão: true em produção). Em produção atrás de proxy HTTPS, mantenha true.
COOKIE_SECURE=
# Número de proxies confiáveis à frente da aplicação (ex.: 1 com Nginx/Render/Railway)
TRUST_PROXY=0

# Armazenamento de arquivos: local (padrão). Outros drivers podem ser adicionados em backend/src/services/storage
STORAGE_DRIVER=local
UPLOAD_MAX_MB=5

# E-mail transacional (SMTP). Se SMTP_HOST ficar vazio, nenhum e-mail é enviado e o sistema registra "envio indisponível".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nome da Empresa <nao-responda@exemplo.com.br>"

# Gateways de pagamento (integração futura — deixe vazio enquanto não houver integração efetiva)
PAYMENT_PROVIDER=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Criação não interativa do primeiro administrador (opcional; use apenas em automação e apague depois)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------- Central de Implantação
# Executor do agente (npm run agente): "linux" (produção, requer deploy/implantacao/preparar-servidor.sh)
# ou "simulado" (percorre o fluxo sem alterar o servidor). Padrão: linux em produção, simulado nos demais.
IMPLANTACAO_EXECUTOR=
# IP(s) públicos deste servidor, separados por vírgula. Usados para conferir o DNS dos domínios dos clientes.
IMPLANTACAO_IPS=
# E-mail de contato para os certificados Let's Encrypt (avisos de expiração).
IMPLANTACAO_EMAIL_SSL=
# Chave para cifrar as credenciais das implantações (32+ caracteres aleatórios). Se vazia, deriva de APP_SECRET.
# Atenção: trocar esta chave (ou APP_SECRET, se ela estiver vazia) torna ilegíveis as credenciais já salvas.
IMPLANTACAO_CHAVE=
# Caminho do auxiliar root instalado (não altere sem motivo).
# IMPLANTACAO_HELPER=/usr/local/lib/vitrine-implantacao/helper.mjs
