# Central de Backup — copie para .env e ajuste. Nunca versione o .env.
NODE_ENV=production

# PostgreSQL: o usuário da URL é o DONO do schema (roda migrations). As consultas da aplicação
# passam para o papel "central_app" (sem login), sujeito a Row Level Security.
DATABASE_URL=postgres://central:TROQUE@127.0.0.1:5432/central_backup
# só para "npm test" (o nome do banco precisa terminar em _test; ele é APAGADO a cada execução)
DATABASE_URL_TEST=postgres://central:TROQUE@127.0.0.1:5432/central_backup_test
DB_APP_ROLE=central_app

# KEK (chave que cifra os segredos do banco). Criada por "npm run ca:init"; guarde cópia FORA do servidor.
KEK_FILE=.data/kek
# material do gateway (CA e TLS), gerado por "npm run ca:init"
GATEWAY_DIR=.data/gateway

# Painel: só local; o Nginx publica em HTTPS. TRUST_PROXY=1 quando atrás do Nginx.
PANEL_HOST=127.0.0.1
PANEL_PORT=4300
TRUST_PROXY=1
# build do painel web servido pelo painel (padrão apps/web/dist; gere com npm run web:build)
# WEB_DIST=apps/web/dist

# Gateway dos agentes (mTLS terminado no próprio Node, sem passar pelo Nginx)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8443
# nomes/IPs pelos quais os agentes acessam a central (vão no certificado do gateway)
GATEWAY_HOSTNAMES=central.exemplo.com.br
GATEWAY_PUBLIC_URL=https://central.exemplo.com.br:8443

# Opcionais (valores padrão)
# AGENT_HEARTBEAT_S=30
# AGENT_OFFLINE_AFTER_S=120
# TASK_LEASE_S=120
# AGENT_CERT_DAYS=90
# AGENT_CERT_RENEW_BEFORE_DAYS=30
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12

# Ferramentas (padrão: PATH; em desenvolvimento .tools/bin)
# RESTIC_BIN=/usr/local/bin/restic
# PG_RESTORE_BIN=/usr/bin/pg_restore

# Prometheus: token de pelo menos 32 caracteres (gere com: openssl rand -hex 32). Sem ele, /api/v1/metrics fica desligado.
# METRICS_TOKEN=

# Alertas por e-mail (SMTP). A senha fica só neste arquivo (permissão 0600).
# SMTP_URL=smtps://alertas%40exemplo.com.br:senha@smtp.exemplo.com.br:465
# SMTP_FROM="Central de Backup <alertas@exemplo.com.br>"

# Fase 7 — origem do agente usada pelo cloud-init de DR (repositório https e commit/tag fixados)
# AGENT_SOURCE_REPO=https://github.com/sua-org/vitrine-softwares.git
# AGENT_SOURCE_REF=v1.0.0

# Fase 8 — backup da própria central (repositório restic SEPARADO, de preferência fora desta máquina)
# SELF_BACKUP_REPOSITORY=rest:https://central:SENHA@backup-externo.exemplo.com.br:8000/central
# SELF_BACKUP_PASSWORD_FILE=.data/self-backup.pw   # criado na primeira execução (0400); vai no kit
# SELF_BACKUP_SCHEDULE=30 1 * * *
# SELF_BACKUP_TZ=America/Sao_Paulo
# SELF_BACKUP_KEEP_LAST=30                          # só se o repositório não for append-only
# PG_DUMP_BIN=pg_dump
# Kit de recuperação: frase-senha por arquivo (nunca por argumento); sem ela, é pedida no terminal
# KIT_PASSPHRASE_FILE=/root/frase-do-kit.txt
# No AGENTE (servidor do cliente): PGBACKREST_MODE=direto só se o agente já rodar como dono do PGDATA
